# NETWATCH configuration. Copy to .env and fill what you need. All keys are FREE.
# Nothing here is required for the app to start.

# Contact string sent in the User-Agent of every request (SEC EDGAR requires one).
NETWATCH_CONTACT=you@example.com

# Server
NETWATCH_HOST=127.0.0.1
NETWATCH_PORT=8000

# Retention policy (days)
NETWATCH_RETENTION_FULLTEXT_DAYS=30
NETWATCH_RETENTION_META_DAYS=365

# Clustering: "tfidf" (light, default) or "embeddings" (needs requirements-optional.txt)
NETWATCH_CLUSTER_MODE=tfidf

# --- Optional free API keys ---
# ACLED (free, non-commercial): https://acleddata.com/register/
ACLED_EMAIL=
ACLED_KEY=
# FRED (free): https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
# Alpha Vantage free tier (fallback for quotes if Stooq is unavailable)
ALPHAVANTAGE_KEY=
# OpenSanctions API (free for non-commercial use)
OPENSANCTIONS_KEY=
# DeepL API Free (optional, Argos Translate is the local default)
DEEPL_API_KEY=
# ReliefWeb requires a registered appname: https://apidoc.reliefweb.int/
RELIEFWEB_APPNAME=
# US Senate LDA API key (if required by the service)
LDA_API_KEY=
